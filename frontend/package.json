{
  "name": "palet-top",
  "version": "0.0.0",
  "description": "Angular 21 admin/player web client for PaletTop, a tournament management app for the French game Palet.",
  "license": "GPL-3.0-only",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "prebuild": "node scripts/set-version.mjs",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "format": "prettier --write \"src/**/*.{ts,html,scss}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss}\"",
    "icons:pwa": "node scripts/generate-pwa-icons.mjs"
  },
  "private": true,
  "packageManager": "npm@10.9.0",
  "dependencies": {
    "@angular/animations": "^21.2.5",
    "@angular/cdk": "^21.2.5",
    "@angular/common": "^21.2.5",
    "@angular/compiler": "^21.2.5",
    "@angular/core": "^21.2.5",
    "@angular/forms": "^21.2.5",
    "@angular/material": "^21.2.5",
    "@angular/platform-browser": "^21.2.5",
    "@angular/router": "^21.2.5",
    "@angular/service-worker": "^21.2.5",
    "@ngrx/effects": "^21.1.0",
    "@ngrx/store": "^21.1.0",
    "@ngrx/store-devtools": "^21.1.0",
    "exceljs": "^4.4.0",
    "ngx-toastr": "^20.0.5",
    "rxjs": "~7.8.0",
    "socket.io-client": "^4.8.3",
    "tslib": "^2.3.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@angular/build": "^21.2.5",
    "@angular/cli": "^21.2.5",
    "@angular/compiler-cli": "^21.2.5",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "sharp": "^0.33.5",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
