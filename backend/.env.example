PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=palet

## Optional. Set to "dev-bdd" to drop & resynchronize the schema from entities
## on every startup instead of running migrations (see `npm run start:devDb`).
## Leave unset for normal migration-based development.
# APP_ENV=dev-bdd

## ================
## Automatic tournament cleanup (permanent deletion). All variables below are
## optional; the values shown are the defaults used when left unset.

## Global cleanup activation: disables all cleanup rules when set to "false".
# CLEANUP_ENABLED=true

## Cron expression ("minute hour day month weekday") controlling how often
## cleanup runs. Defaults to every day at 3am.
# CLEANUP_CRON_EXPRESSION=0 3 * * *

## COMPLETED tournaments: deleted `n` days after they were completed.
# CLEANUP_COMPLETED_ENABLED=true
# CLEANUP_COMPLETED_RETENTION_DAYS=7

## DRAFT tournaments: deleted `n` days after creation, but only if the
## tournament's planned date is more than `m` days in the future.
## A planned date that far out is treated as junk/spam rather than a real draft.
# CLEANUP_DRAFT_ENABLED=true
# CLEANUP_DRAFT_RETENTION_DAYS=7
# CLEANUP_DRAFT_MAX_FUTURE_DAYS=365

## ACTIVE tournaments: deleted `n` days after they were activated (started).
# CLEANUP_ACTIVE_ENABLED=true
# CLEANUP_ACTIVE_RETENTION_DAYS=7
