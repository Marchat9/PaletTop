{
    "name": "palet-backend",
    "version": "0.1.0",
    "description": "NestJS REST + WebSocket API for PaletTop, a tournament management app for the French game Palet.",
    "license": "GPL-3.0-only",
    "private": true,
    "scripts": {
        "start": "nest start",
        "start:dev": "nest start --watch",
        "start:devDb": "cross-env APP_ENV=dev-bdd nest start --watch",
        "start:debug": "nest start --debug --watch",
        "start:debug:devDb": "cross-env APP_ENV=dev-bdd nest start --debug --watch",
        "build": "nest build",
        "lint": "eslint \"src/**/*.ts\"",
        "lint:fix": "eslint \"src/**/*.ts\" --fix",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:cov": "vitest run --coverage",
        "format": "prettier --write \"src/**/*.ts\"",
        "format:check": "prettier --check \"src/**/*.ts\"",
        "typeorm": "cross-env NODE_OPTIONS=\"-r tsconfig-paths/register\" typeorm-ts-node-commonjs -d src/database/data-source.ts",
        "migration:generate": "npm run typeorm -- migration:generate src/database/migrations/SchemaUpdate",
        "migration:create": "npm run typeorm -- migration:create src/database/migrations/ManualMigration",
        "migration:run": "npm run typeorm -- migration:run",
        "migration:revert": "npm run typeorm -- migration:revert"
    },
    "dependencies": {
        "@nestjs/common": "^11.0.0",
        "@nestjs/config": "^4.0.0",
        "@nestjs/core": "^11.0.0",
        "@nestjs/platform-express": "^11.0.0",
        "@nestjs/platform-socket.io": "^11.0.0",
        "@nestjs/schedule": "^6.1.3",
        "@nestjs/typeorm": "^11.0.0",
        "@nestjs/websockets": "^11.0.0",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.1",
        "cron": "^4.4.0",
        "pg": "^8.13.1",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.1",
        "socket.io": "^4.8.1",
        "typeorm": "^0.3.20",
        "uuid": "^11.0.4"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@nestjs/cli": "^11.0.0",
        "@types/node": "^22.10.2",
        "cross-env": "^7.0.3",
        "eslint": "^9.17.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.6",
        "prettier": "^3.9.6",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.7.2",
        "typescript-eslint": "^8.65.0",
        "vitest": "^4.1.10"
    }
}
